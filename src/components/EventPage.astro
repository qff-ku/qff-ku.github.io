---
import type { EventContent } from "../data/2026";
import "../styles/global.css";
import clubLogo from "../../logo/QUICK_LOGO2.png";
import sidebarClubLogo from "../../logo/QUICK_LOGO1.png";
import eventArtwork from "../../logo/Fall Fest Sticker Small.png";
import qiskitPictogram from "../../Pictogram/SVG/qiskit_purple-60.svg";
import ibmQuantumLogotype from "../../IBM_Quantum/IBM_Quantum/Raster/RGB/IBM_Quantum_logotype_pos_RGB.png";
import universityLogo from "../../logo/black1negative.gif";

interface Props {
  content: EventContent;
}

const { content } = Astro.props;
const isKorean = content.lang === "ko";
const [heroTitle, heroSubtitle] = content.hero.heading.split("\n");
const heroName = heroTitle.slice(0, -5);
const heroYear = heroTitle.slice(-4);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const koreanUrl = new URL("/2026/ko/", canonical);
const englishUrl = new URL("/2026/en/", canonical);
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0f14" />
    <meta name="description" content={content.description} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={content.ogLocale} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={koreanUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={koreanUrl} />
    <title>{content.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{content.skipLabel}</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="site-identity">
          <a class="sidebar-logo-link" href={isKorean ? "/2026/ko/" : "/2026/en/"} aria-label={isKorean ? "홈으로 이동" : "Go to home"}>
            <img class="sidebar-club-logo" src={sidebarClubLogo.src} width={sidebarClubLogo.width} height={sidebarClubLogo.height} alt="" />
          </a>
          <a class="brand" href={isKorean ? "/2026/ko/" : "/2026/en/"} aria-label="Qiskit Fall Fest 2026 at Korea University">Qiskit Fall Fest <span>2026</span></a>
          <span class="affiliation">at Korea University</span>
        </div>
        <nav class="section-nav" aria-label={content.navLabel}>
          {content.nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="sidebar-university-link" href="https://www.korea.ac.kr/sites/ko/index.do" target="_blank" rel="noopener noreferrer" aria-label={isKorean ? "고려대학교 홈페이지로 이동" : "Visit the Korea University website"}>
          <img class="sidebar-university-logo" src={universityLogo.src} width={universityLogo.width} height={universityLogo.height} alt="" />
        </a>
      </div>
    </header>
    <div class="top-controls">
      <details class="mobile-menu">
        <summary>{isKorean ? "메뉴" : "Menu"}</summary>
        <nav aria-label={content.navLabel}>
          {content.nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
      </details>
      <nav class="language-nav" aria-label={content.languageLabel}>
        <a href="/2026/ko/" lang="ko" aria-current={isKorean ? "page" : undefined}>KO</a>
        <span aria-hidden="true">/</span>
        <a href="/2026/en/" lang="en" aria-current={!isKorean ? "page" : undefined}>EN</a>
      </nav>
    </div>
    <a class="floating-registration" href="#registration">
      <span class="floating-registration-label">{content.hero.registrationLabel}</span>
      <span class="floating-registration-arrow" aria-hidden="true">↘</span>
    </a>

    <main id="content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-orbit" aria-hidden="true">
          <svg class="bloch-sphere" viewBox="0 0 400 400">
            <defs>
              <marker id="bloch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
                <path class="bloch-arrowhead" d="M 0 0 L 10 5 L 0 10 Z"></path>
              </marker>
            </defs>
            <circle class="bloch-outline" cx="200" cy="200" r="142"></circle>
            <ellipse class="bloch-ring" cx="200" cy="200" rx="142" ry="46"></ellipse>
            <ellipse class="bloch-ring" cx="200" cy="200" rx="46" ry="142" transform="rotate(36 200 200)"></ellipse>
            <ellipse class="bloch-ring" cx="200" cy="200" rx="46" ry="142" transform="rotate(-36 200 200)"></ellipse>
            <line class="bloch-axis" x1="200" y1="42" x2="200" y2="358"></line>
            <line class="bloch-axis" x1="58" y1="200" x2="342" y2="200"></line>
            <g class="bloch-state-vector">
              <line class="bloch-vector" x1="200" y1="200" x2="293.3" y2="106.7" marker-end="url(#bloch-arrow)"></line>
              <circle class="bloch-state" cx="300.41" cy="99.59" r="7"></circle>
              <text class="bloch-label bloch-label-state" x="310" y="96">|ψ⟩</text>
            </g>
            <circle class="bloch-core" cx="200" cy="200" r="5"></circle>
            <text class="bloch-label" x="200" y="42" text-anchor="middle">|0⟩</text>
            <text class="bloch-label" x="200" y="374" text-anchor="middle">|1⟩</text>
          </svg>
        </div>
        <div class="hero-copy">
          <div class="hero-meta">
            <p class="eyebrow">{content.hero.eyebrow}</p>
            <span class="sr-only">{content.hero.status}</span>
          </div>
          <h1 id="hero-title" aria-label={`${heroTitle} ${heroSubtitle}`}>
            <span class="hero-title-primary">{heroName} <span class="hero-year">{heroYear}<span class="status hero-status" aria-hidden="true">{content.hero.status}</span></span></span>
            <span class="hero-title-secondary">{heroSubtitle}</span>
          </h1>
          <p class="status mobile-status" aria-hidden="true">{content.hero.status}</p>
          <p class="hero-affiliation">{content.hero.affiliation}</p>
          <p class="hero-summary">{content.hero.summary} <span>{content.hero.summaryTail}</span></p>
          <a class="text-link" href="#about">{content.hero.linkLabel}<span aria-hidden="true"> ↘</span></a>
        </div>
        <dl class="facts">
          <div>
            <dt>{content.hero.dateLabel}</dt>
            <dd>{content.hero.date}</dd>
          </div>
          <div>
            <dt>{content.hero.venueLabel}</dt>
            <dd>{content.hero.venue}</dd>
          </div>
        </dl>
      </section>

      <section class="section about-layout" id="about" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h2 id="about-title">{content.about.title}</h2>
          <p class="lead">{content.about.body}</p>
        </div>
        <img
          class="event-artwork"
          src={eventArtwork.src}
          width={eventArtwork.width}
          height={eventArtwork.height}
          alt={isKorean ? "Qiskit Fall Fest 2026 공식 행사 그래픽" : "Qiskit Fall Fest 2026 official event graphic"}
          loading="lazy"
        />
      </section>

      <section class="section" id="program" aria-labelledby="program-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{content.program.eyebrow}</p>
            <h2 id="program-title">{content.program.title}</h2>
          </div>
          <p>{content.program.body}</p>
        </div>
        <div class="program-grid">
          {content.program.days.map((day, index) => (
            <article class="program-day">
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{day.label}</h3>
                <p>{day.status}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split" id="registration" aria-labelledby="registration-title">
        <div>
          <p class="eyebrow">{content.registration.eyebrow}</p>
          <h2 id="registration-title">{content.registration.title}</h2>
          <p>{content.registration.note}</p>
        </div>
        <dl class="info-list">
          <div><dt>{content.registration.statusLabel}</dt><dd>{content.registration.status}</dd></div>
          <div><dt>{content.registration.periodLabel}</dt><dd>{content.registration.period}</dd></div>
          <div><dt>{content.registration.eligibilityLabel}</dt><dd>{content.registration.eligibility}</dd></div>
        </dl>
      </section>

      <section class="section venue" id="venue" aria-labelledby="venue-title">
        <div>
          <p class="eyebrow">{content.venue.eyebrow}</p>
          <h2 id="venue-title">{content.venue.title}</h2>
          <p class="lead">{content.venue.body}</p>
        </div>
        <div class="map-placeholder" role="img" aria-label={content.venue.mapLabel}>
          <span>Qiskit Fall Fest</span>
          <p>{content.venue.mapLabel}</p>
        </div>
      </section>

      <section class="section split" id="faq" aria-labelledby="faq-title">
        <div>
          <p class="eyebrow">{content.faq.eyebrow}</p>
          <h2 id="faq-title">{content.faq.title}</h2>
        </div>
        <details>
          <summary>{content.faq.question}</summary>
          <p>{content.faq.answer}</p>
        </details>
      </section>

      <section class="section partners" aria-labelledby="partners-title">
        <p class="eyebrow">{content.partners.eyebrow}</p>
        <h2 id="partners-title">{content.partners.title}</h2>
        <p class="partners-copy">{content.partners.body}</p>
        <div class="logo-grid" aria-label={content.partners.logoAreaLabel}>
          <a class="logo-link" href="https://quick.oopy.io/" target="_blank" rel="noopener noreferrer">
            <figure class="logo-card">
              <img src={clubLogo.src} width={clubLogo.width} height={clubLogo.height} alt="" loading="lazy" />
              <figcaption>{content.partners.hostLabel}</figcaption>
            </figure>
          </a>
          <a class="logo-link" href="https://www.ibm.com/quantum" target="_blank" rel="noopener noreferrer">
            <figure class="logo-card ibm-card">
              <div class="ibm-lockup">
                <img class="ibm-mark" src={qiskitPictogram.src} width={qiskitPictogram.width} height={qiskitPictogram.height} alt="" loading="lazy" />
                <img class="ibm-wordmark" src={ibmQuantumLogotype.src} width={ibmQuantumLogotype.width} height={ibmQuantumLogotype.height} alt="" loading="lazy" />
              </div>
              <figcaption>{content.partners.ibmLabel}</figcaption>
            </figure>
          </a>
          <figure class="logo-card sponsor-placeholder">
            <span aria-hidden="true">+</span>
            <figcaption>{content.partners.sponsorLabel}</figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer>
      <p class="brand">Qiskit Fall Fest <span>2026</span></p>
      <p>{content.footer.note}</p>
      <p>{content.footer.copyright}</p>
    </footer>
    <script>
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".section-nav a[href^='#']"));
      const linksById = new Map(links.map((link) => [link.hash.slice(1), link]));
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => link.removeAttribute("aria-current"));
          linksById.get(entry.target.id)?.setAttribute("aria-current", "location");
        }
      }, { rootMargin: "-30% 0px -60%", threshold: 0 });

      document.querySelectorAll("main > section").forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
